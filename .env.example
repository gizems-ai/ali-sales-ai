# ════════════════════════════════════════════════════════════════════════════
#  ali-sales-ai — ortam değişkenleri örneği
#
#  .gitignore'daki `.env*` deseni bu dosyayı da yok sayıyordu; `!.env.example`
#  satırı onaylı istisna olarak eklendi (Gün 2). Bu dosya artık takip ediliyor.
#  GERÇEK DEĞER YAZMA — yalnız anahtar adları ve açıklama.
# ════════════════════════════════════════════════════════════════════════════

# ─── Mevcut panel (emlak / sigorta) — DEĞİŞTİRME ────────────────────────────
# Bu bloktaki değerler mevcut prod deployment'larına aittir.
AIRTABLE_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
N8N_ALI_WEBHOOK_URL=
DIALOG360_KEY=

# ════════════════════════════════════════════════════════════════════════════
#  STORE OS (Gratis demosu) — yalnız Gratis Vercel projesinde tanımlanır.
#  Emlak/sigorta projelerine BU DEĞİŞKENLERİ EKLEME.
# ════════════════════════════════════════════════════════════════════════════

# Airtable — Store OS'e ayrılmış YENİ base. Emlak/sigorta base'leri değil.
# Token kapsamı: data.records:read + data.records:write + schema.bases:read,
# yalnız bu base seçili.
STOREOS_AIRTABLE_BASE_ID=app000000000000
STOREOS_AIRTABLE_API_KEY=pat000000000000

# Vision partnerinden gelen olayların HMAC-SHA256 paylaşılan sırrı.
# Üret: openssl rand -hex 32
STOREOS_INGEST_SECRET=

# n8n → /api/storeos/wa/inbound çağrısının bearer token'ı.
# Üret: openssl rand -hex 32
STOREOS_WA_INBOUND_TOKEN=

# Panel → n8n giden WhatsApp webhook'u (YENİ workflow; echo bot değil).
STOREOS_N8N_WA_WEBHOOK_URL=https://n8n.alisales.ai/webhook/storeos-wa-giden

# Aktif bildirim kanalı: konsol | whatsapp
# Gerçek 360Dialog hattı bağlanana kadar 'konsol'.
STOREOS_KANAL=konsol

# /storeos/demo-kontrol'e erişebilen Clerk kullanıcı ID'leri (virgülle ayrık).
STOREOS_ADMIN_CLERK_IDS=

# Store OS'in prod host'u. src/lib/storeos/host-guard.ts içindeki
# STOREOS_PROD_HOSTLARI listesiyle tutarlı olmalı.
STOREOS_HOST=

# Depo seçimi: bellek | airtable
# Boş bırakılırsa: Airtable kimlik bilgileri varsa 'airtable', yoksa 'bellek'.
# DİKKAT: 'bellek' Vercel lambda'ları arasında paylaşılmaz — yalnız yerel/CI.
STOREOS_DEPO=

# İmza zaman damgası toleransı (saniye). Varsayılan 300.
STOREOS_IMZA_TOLERANS_SN=300

# Panonun gösterdiği mağaza. Demoda tek mağaza var; boş bırakılırsa 0178.
STOREOS_MAGAZA_KODU=0178
