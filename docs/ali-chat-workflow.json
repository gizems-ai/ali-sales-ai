            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.3,
          "maxTokens": 500
        }
      },
      "id": "ali-openai",
      "name": "OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [560, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"cevap\": (($json.message && $json.message.content) || $json.content || $json.text || $json.output || \"\") } }}",
        "options": {}
      },
      "id": "ali-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
